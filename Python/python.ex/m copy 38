    print(f'computador jogou {it[com]}')
    print(f'jogador jogou {it[es]}')
    if com ==0:
        if es == 0:
            print('empate')
        elif es ==1:
            print('voce venceu')
        else:
            print('voce perdeu')
    elif com==1:
        if es == 0:
            print('voce venceu')
        elif es ==1:
            print('empate')
        else:
            print('voce vence')
    elif com==2:
        if es == 0:
            print('voce vence')
