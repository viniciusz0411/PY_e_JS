ficha=list()
while True:
    nome=str(input('nome: '))
    nota1=int(input('nota 1: '))
    nota2=int(input('nota 2: '))
    media=(nota1+nota2)/2
    ficha.append([nome, [nota1,nota2], media])
    cont=str(input('deseja continuar? ')).upper()[0]
    if cont in 'N':
        break
print('-'*30)
print(f'{'N':<4}{'NOME':<10}{'MEDIA':>8}')
print('-'*30)
for i, a in enumerate(ficha):
    print(f'{i+1:<4}{a[0]:<10}{a[2]:>8}')
while True:  
    mostra=int(input('nota de qual aluno deseja mostrar(999 para sair)? '))-1
    if mostra==999:
        break
    if mostra<=len(ficha):
        print(f'a nota do aluno {ficha[mostra][0]} é {ficha[mostra][1]}')
print(ficha)