from datetime import date
atual=date.today().year
totmaior=0
totmenor=0
for pessoas in range(1, 8):
    nas = int(input(f'que ano a {pessoas} pessoa nasceu '))
    idd =atual - nas
    if idd < 18:
        totmenor= totmenor+1
    else:
        totmaior= totmaior+1
print(f'tem {totmenor} pessoas menor de idade, e {totmaior} maiores de idade')