from random import randint
v=0

while True:
    n = randint(0, 11)
    nm = int( input('escolha um numero: '))
    tipo=' '
    s = n + nm
    while tipo not in 'PI':
        tipo = str(input('par ou impar? I/P: ')).upper().strip()[0]
    print(f'voce jogou {nm}, jogador jogou {n}, com total de {s}')
    if tipo =='P':
        if s % 2 ==0:
                print('voce ganhou')
                v=v+1
        else:
                break
    elif tipo =='I':
        if s %2 ==1:
            print('voce ganhou')
            v=v+1
        else: 
             print('voce perdeu')
             break
        print('vamos jogar de novo')
print(f'voce venceu {v} partidas')
